---
import type { InferGetStaticPropsType } from 'astro';
import { TEMPLATE_CATALOG } from '@platfolio/manifest';
import { Breadcrumbs, MainContext, WorkspaceHeading, WorkspacePanel, describeTemplate, templatePaths, workspacePaths } from '@platfolio/ui';
import TemplateCatalogPage from '../../layouts/template-catalog-page.astro';

export function getStaticPaths() {
  return TEMPLATE_CATALOG.map((entry) => ({ params: { template: entry.name }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const display = describeTemplate(entry.name);
const source = `https://github.com/${entry.repo}`;
---
<TemplateCatalogPage title={`${display.title} — Platfolio`} description={display.summary}>
  <Fragment slot="heading">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Templates', href: templatePaths.catalog }, { label: display.title }]} />
    <WorkspaceHeading title={display.title}><p>{display.summary}</p></WorkspaceHeading>
  </Fragment>
  <div data-release-template={entry.name} data-release-repo={entry.repo}>
    <div class="ui-workspace-page-actions">
      <span data-release-install hidden><a class="ui-workspace-primary ui-hit-primary" href={workspacePaths.home}>Choose a team to install</a></span>
      <a class="ui-workspace-secondary ui-hit-primary" href={templatePaths.catalog}>All templates</a>
    </div>
    <MainContext>
      <WorkspacePanel title="What runs">
        <dl class="ui-workspace-facts">
          <div><dt>Type</dt><dd>{display.kind} · {display.mode}</dd></div>
          <div><dt>Public access</dt><dd>{display.access}</dd></div>
          <div><dt>Capabilities</dt><dd>{display.capabilities.join(' · ')}</dd></div>
          {entry.devOverlayPath && <div><dt>Local development</dt><dd>Run locally with Docker Compose</dd></div>}
          <div><dt>Template price</dt><dd>Free. Your hosting provider charges for resources you use.</dd></div>
        </dl>
      </WorkspacePanel>
      <WorkspacePanel title="Source" context>
        <dl class="ui-workspace-facts">
          <div><dt>Publisher</dt><dd>{entry.repo.split('/')[0]}</dd></div>
          <div><dt>Repository</dt><dd><a href={source}>{entry.repo}</a></dd></div>
          <div data-release-only hidden><dt>Pinned release</dt><dd><a data-release-version data-release-tree hidden></a></dd></div>
        </dl>
        <ul class="ui-workspace-list ui-resource-list" data-release-only hidden>
          <li><a data-release-file={entry.composePath} hidden>App services (Compose file)</a></li>
          <li><a data-release-file={entry.inventoryPath} hidden>Required configuration</a></li>
        </ul>
      </WorkspacePanel>
    </MainContext>
  </div>
</TemplateCatalogPage>
