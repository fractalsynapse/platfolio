---
import { templatePaths } from '@platfolio/ui';
import Page from '../layouts/page.astro';
---
<Page title="Platfolio — Put your app online">
  <div class="ui-columns ui-welcome" data-columns="welcome">
    <section class="ui-prose ui-public-intro">
      <div>
        <h1>Put your app online</h1>
        <p>Run Platfolio in your own hosting account. Deploy apps from its marketplace and keep control of your infrastructure, data, and credentials.</p>
        <div class="ui-workspace-links">
          <a class="ui-workspace-primary ui-hit-primary" href="/sign-in">Sign in</a>
          <a class="ui-workspace-secondary ui-hit-primary" href={templatePaths.catalog}>Browse templates</a>
          <a class="ui-workspace-secondary ui-hit-primary" href="/docs">Read the hosting guide</a>
        </div>
      </div>
    </section>
    <section class="ui-workspace-panel" aria-label="How hosting works">
      <h2>How hosting works</h2>
      <ol class="ui-hosting-steps">
        <li><strong>Launch private Platfolio</strong><p>Connect your hosting account and save the instructions for your first sign-in.</p></li>
        <li><strong>Connect to the marketplace</strong><p>Use Connections in your private workspace to set up secret storage and connect to the marketplace.</p></li>
        <li><strong>Deploy a platform</strong><p>Choose a release from your private workspace and check its deployment there.</p></li>
      </ol>
    </section>
  </div>
</Page>
