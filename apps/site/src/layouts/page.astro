---
/**
 * The shared page shell.
 *
 * Nothing below is a design language: every value comes from `packages/ui/src/tokens.ts` through the generated
 * `tokens.css` (D63 — one place for colour, spacing and type; this file imports the sheet rather than restating
 * it), and `scripts/check-ui.ts` §D65 reads this app's styles for exactly that line.
 *
 * ## The one thing here that is about D65 rather than HTML
 *
 * `scriptSrc` is set only by a page that hydrates. `/` passes nothing and therefore ships no JavaScript at all —
 * which is the claim Astro was chosen for, and `apps/site/test/build-output.test.ts` measures it in `dist/`
 * instead of inferring it from this file. The overlay it loads (`/config.js`) carries endpoints, never a
 * credential, and `public/config.js` is tracked as a comment because a committed origin is D47's failure.
 */
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  workspace?: boolean;
  /** A page that mounts an island names the overlay here; a page that ships no JavaScript leaves it undefined. */
  scriptSrc?: string;
}

const {
  title,
  description = 'Managed hosting of standalone platforms on infrastructure the tenant owns.',
  scriptSrc,
  workspace = false,
} = Astro.props;
const origin = Astro.site ?? new URL(Astro.request.url).origin;
---
<!doctype html>
<html lang="en" data-ui-scheme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, origin)} />
    {scriptSrc !== undefined ? <script is:inline src={scriptSrc}></script> : null}
  </head>
  <body>
    {workspace ? <slot /> : <>
      <header class="ui-workspace-header">
        <div class="ui-workspace-header-inner">
          <a class="ui-workspace-wordmark ui-hit-primary" href="/"><span class="ui-workspace-mark" aria-hidden="true">P</span>Platfolio</a>
          <a class="ui-workspace-secondary ui-hit-primary" href="/dashboard">Sign in</a>
        </div>
      </header>
      <main class="ui-public-main">
        <slot />
      </main>
    </>}
  </body>
</html>
