# Reference clones kept for context, not project source (e.g. examples/scaffold)
examples/

# Tool scratch (agent/code-index artifacts for this workspace)
.codegraph/

# Research scratch: fetched provider/legal pages, schema dumps, corpus text.
# Regenerable, large, and not a project source. The durable conclusions live in docs/.
.research/

# Tool caches (the vendored-Cordis git mirror and candidate trees)
.cache/

# Build and dependency artifacts
node_modules/
dist/
# The managed action's bundle is a committed artifact on purpose: `action:check` proves it matches source,
# and a runner that installs packages at run time is a supply chain nobody reviewed.
!.github/actions/**/dist/
coverage/
*.tsbuildinfo

# Local secrets, when used
.env
.env.*
!.env.example

# Workstation artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Transient trees written by local gates
.tmp-*/

# Local development credentials: never committed, never logged, never pasted into chat
.secrets/
*.token

# one-off framework probes that were never meant to be committed
probe.ts

# Local scratch for tooling that insists on writing inside the workspace (docker buildx
# config, npm/pnpm caches). Never a source directory; committed once by accident while
# debugging the self-host image build.
.tmp/

# Local history archive (git bundle). Not project source; see MAINTAINING.
.archive/

# Atomic-write scratch files. A `write` helper that stages `file.tmp` then renames leaves the
# intermediate if the rename fails, and without this rule a `git add -A` commits it: this repository had a
# 461-line copy of a checker sitting in version control until an `add -A` happened to remove it.
*.tmp
