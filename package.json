{
  "name": "platfolio",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "platfolio control plane. Design phase: this manifest exists to make repository tooling and CI gates reproducible, not to publish a package.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsx scripts/check-project.ts",
    "vendor:verify": "tsx scripts/vendor-cordis.ts verify",
    "vendor:check": "tsx scripts/vendor-cordis.ts check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "verify": "pnpm run lock:check && pnpm run install:check && pnpm run check && pnpm run vendor:verify && pnpm run graphql:check && pnpm run api:check && pnpm run action:check && pnpm run typecheck && pnpm run test && pnpm run contracts:check",
    "render:example": "tsx packages/kernel/src/cli.ts render samples/web-app/manifest.yaml",
    "install:check": "pnpm install --frozen-lockfile --prefer-offline",
    "lock:check": "tsx scripts/check-lockfile.ts",
    "graphql:check": "tsx scripts/check-graphql-schema.ts",
    "graphql:snapshot": "tsx scripts/refresh-railway-schema.ts",
    "app:local": "tsx scripts/github-app-local.ts",
    "app:local:check": "tsx scripts/github-app-local.ts --check",
    "app:check": "tsx scripts/github-app-check.ts",
    "install:pr": "tsx scripts/open-install-pr.ts",
    "templates:publish": "tsx scripts/publish-templates.ts",
    "action:bundle": "tsx scripts/bundle-action.ts",
    "action:check": "tsx scripts/bundle-action.ts --check",
    "api:check": "tsx scripts/check-api.ts",
    "identity:seed": "tsx scripts/seed-identity.ts",
    "identity:smoke": "tsx scripts/smoke-identity.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed-dev": "tsx scripts/seed-dev-data.ts",
    "lifecycle:smoke": "tsx scripts/smoke-lifecycle.ts",
    "email:smoke": "tsx scripts/email-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.25.8",
    "railway": "^3.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0"
}
