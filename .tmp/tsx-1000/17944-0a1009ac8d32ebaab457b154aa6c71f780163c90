{"code":"import assert from\"node:assert/strict\";import fs from\"node:fs\";import path from\"node:path\";import{test}from\"node:test\";import{buildDesiredGraph,samplePlan}from\"../src/index.ts\";const FIXTURE=path.join(path.dirname(new URL(import.meta.url).pathname),\"fixtures\",\"railway-desired-graph.json\");const cliOutput=JSON.parse(fs.readFileSync(FIXTURE,\"utf8\"));const NODE_KEYS=[\"address\",\"type\",\"kind\",\"name\",\"engine\",\"variables\",\"source\",\"build\",\"deploy\",\"networking\",\"volumeAttachments\",\"config\",\"groupId\",\"tracing\",\"cdn\"];test(\"the change-set payload matches the captured Railway CLI output in shape\",()=>{const plan=samplePlan();const graph=buildDesiredGraph(plan,plan.environments[0]);const kinds=new Set(graph.resources.map(r=>r.type));assert.ok(kinds.has(\"database\")&&kinds.has(\"bucket\")&&kinds.has(\"service\"),JSON.stringify([...kinds]));const db=graph.resources.find(r=>r.type===\"database\");db.variables={DATABASE_URL:{type:\"reference\",resource:\"database.x\",output:\"y\"}};for(const resource of graph.resources){assert.deepEqual(Object.keys(resource).sort(),[...NODE_KEYS].sort(),`${resource.address} key set diverges from the CLI`);assert.match(resource.address,new RegExp(`^${resource.type}\\\\.`),\"address must be type.name, as the differ expects\")}for(const fixtureNode of cliOutput.resources){assert.deepEqual(Object.keys(fixtureNode).sort(),[...NODE_KEYS].sort(),`fixture node ${fixtureNode.address} drifted from the documented key set`)}});test(\"a database node carries Railway template image, not one we chose\",()=>{const plan=samplePlan();const graph=buildDesiredGraph(plan,plan.environments[0]);const db=graph.resources.find(r=>r.type===\"database\");assert.ok(db);assert.equal(db.engine,\"postgres\");assert.match(String(db.source?.image),/^ghcr\\.io\\/railwayapp-templates\\/postgres-ssl:/,\"managed databases come from Railway template registry\");assert.equal(db.kind,\"database\")});test(\"bucket region survives; a