{"code":"import assert from\"node:assert/strict\";import{test}from\"node:test\";import{DEFAULT_APP_PERMISSIONS,GithubAppProvider,GithubPatProvider,MANIFEST_KEYS,buildAppManifest,localDevManifest}from\"../src/index.ts\";const app=new GithubAppProvider;const CONFIG={name:\"platfolio (dev)\",url:\"https://platfolio.example\",callbackUrl:\"https://platfolio.example/api/scm/github/registration-callback\",description:\"Managed hosting control plane\"};test(\"the manifest asks for exactly the permissions the design names\",()=>{const manifest=app.appManifest(CONFIG);assert.deepEqual(manifest.default_permissions,{...DEFAULT_APP_PERMISSIONS},\"the documented object, not a string\");assert.deepEqual(manifest.default_events,[],\"v1 registers no webhook events\");assert.equal(manifest[\"hook_attributes\"],void 0,\"no webhook is registered when nothing can answer it\")});test(\"a webhook is registered only when given a URL that can receive it\",()=>{const withHook=app.appManifest({...CONFIG,webhookUrl:\"https://smee.io/abc\"});assert.deepEqual(withHook.hook_attributes,{url:\"https://smee.io/abc\",active:false})});test(\"a permission widening is a visible diff, not a silent one\",()=>{const wider=app.appManifest({...CONFIG,permissions:{...DEFAULT_APP_PERMISSIONS,administration:\"write\"}});assert.equal(wider.default_permissions?.administration,\"write\");assert.ok(!(\"security_events\"in DEFAULT_APP_PERMISSIONS),\"a permission outside the default set stays outside\")});test(\"the registration URL is the POST target, with no manifest encoded into a GET\",()=>{const state=\"aB3-.x9_qZ7kLm21\";const url=app.registrationUrl(CONFIG,state);assert.equal(url,\"https://github.com/settings/apps/new?state=aB3-.x9_qZ7kLm21\");assert.ok(!url.includes(\"manifest=\"),\"no manifest in a GET link\");assert.equal(app.registrationUrl({...CONFIG,org:\"acme\"},state),\"https://github.com/organizations/acme/settings/apps/new?state=aB3-.x9_qZ7kLm21\")});test(\"a short or guessable state is refused\",()