{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import assert from\"node:assert/strict\";import{createHash}from\"node:crypto\";import fs from\"node:fs\";import path from\"node:path\";import{test}from\"node:test\";import{InfraPlanSchema,planIssues}from\"@platfolio/contracts\";import{RailwayInfraProvider}from\"@platfolio/contracts\";import{RailwayMock}from\"../../../packages/contracts/test/railway-mock.ts\";import{buildPlan,parse}from\"../src/index.ts\";const dir=path.resolve(\"samples\");const raw=__name(f=>fs.readFileSync(path.join(dir,f,\"manifest.yaml\"),\"utf8\"),\"raw\");function loaded(name){const result=parse(raw(name));if(!result.manifest)throw new Error(`template \"templates/${name}\" did not parse: ${JSON.stringify(result.issues)}`);return result.manifest}__name(loaded,\"loaded\");const webApp=loaded(\"web-app\");const fullStack=loaded(\"full-stack\");function realDigest(seed){return`sha256:${createHash(\"sha256\").update(seed).digest(\"hex\")}`}__name(realDigest,\"realDigest\");const pinned=__name((names,tag=\"1.4.0\")=>Object.fromEntries(names.map(n=>[n,{image:`ghcr.io/acme/${n}:${tag}`,digest:realDigest(`${n}@${tag}`)}])),\"pinned\");test(\"a manifest becomes a plan the contract accepts\",()=>{const plan=buildPlan(webApp,{instanceId:\"inst-a1\",teamId:\"team-a1\",images:pinned([\"api\",\"worker\"])});assert.doesNotThrow(()=>InfraPlanSchema.parse(plan));assert.deepEqual(planIssues(plan),[],JSON.stringify(planIssues(plan)));assert.equal(plan.provider,\"railway\");assert.equal(plan.manifestRef.template,\"example-web-app\");assert.match(plan.planHash,/^[a-f0-9]{16,64}$/,\"planHash is a real digest, so re-applies are idempotent\")});test(\"placement, replicas and staging duplication follow the environment model\",()=>{const plan=buildPlan(webApp,{instanceId:\"inst-a2\",teamId:\"team-a2\",images:pinned([\"api\",\"worker\"])});const prod=plan.environments.find(e=>e.name===\"production\